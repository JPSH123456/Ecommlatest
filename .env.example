# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# MS SQL Server connection settings - REQUIRED
DB_SERVER=localhost
DB_PORT=1433
DB_USER=SA
DB_PASSWORD=YourSecurePassword123!
DB_NAME=master

# Alternative: Use DATABASE_URL for cloud databases (Azure SQL, etc.)
# DATABASE_URL=

# ============================================================
# JWT / AUTHENTICATION CONFIGURATION
# ============================================================
# Secret key for JWT token signing - REQUIRED (change this!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-change-me-in-production

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token expiration in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# API CONFIGURATION
# ============================================================
# API Gateway base URL (used by frontend and seed script)
API_URL=http://localhost:8000
VITE_API_HOST=http://localhost:8000

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================
# Application mode
VITE_APP_MODE=development

# Admin PIN for dashboard access
VITE_ADMIN_PIN=525127948

# ============================================================
# MONITORING & TELEMETRY
# ============================================================
# Azure Application Insights connection string (optional)
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# ============================================================
# DEPLOYMENT-SPECIFIC SETTINGS
# ============================================================
# Set to "production" for live environments
ENVIRONMENT=development

# ============================================================
# IMPORTANT SECURITY NOTES
# ============================================================
# 1. NEVER commit this file to version control
# 2. Rotate DB_PASSWORD and JWT_SECRET_KEY regularly
# 3. Use strong passwords (min 16 characters recommended)
# 4. Generate new JWT_SECRET_KEY for each environment:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# 5. Store sensitive values in:
#    - Docker secrets (production)
#    - Azure Key Vault (cloud)
#    - Environment variables (CI/CD)
#    - SSH/secure credential managers (developers)
